{
  "expo": {
    "name": "GeoCatastro",
    "slug": "geocatastro",
    "version": "3.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "imageWidth": 320
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permite a GeoCatastro acceder a tu ubicación actual para situarte en el mapa y cargar el catastro correspondiente."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a GeoCatastro acceder a tus fotos para adjuntarlas a tus fincas favoritas.",
          "cameraPermission": "Permite a GeoCatastro usar la cámara para tomar fotos de tus fincas favoritas."
        }
      ],
      "expo-sharing"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thesorian.geocatastro",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Permite a GeoCatastro acceder a tu ubicación actual para situarte en el mapa y cargar el catastro correspondiente.",
        "NSCameraUsageDescription": "Permite a GeoCatastro tomar fotos de tus parcelas favoritas.",
        "NSPhotoLibraryUsageDescription": "Permite a GeoCatastro adjuntar fotos de tus parcelas favoritas."
      }
    },
    "android": {
      "package": "com.thesorian.geocatastro",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "splash": {
        "image": "./assets/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF"
      },
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "de1772fa-ea66-4a54-b4e4-b87c465da10f"
      }
    },
    "owner": "thesorian",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/de1772fa-ea66-4a54-b4e4-b87c465da10f",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
